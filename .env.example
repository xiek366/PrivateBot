# ---- OneBot 反向 WebSocket ----
ONEBOT_WS_HOST=127.0.0.1
ONEBOT_WS_PORT=8080
ONEBOT_WS_PATH=/onebot
ONEBOT_ACCESS_TOKEN=my-token-change-me

# ---- 权限 ----
# 允许使用机器人的 QQ 号（能跟机器人对话的账号，不是机器人自己的号），多个用逗号分隔
ALLOWED_QQ=10001
AUTO_ACCEPT_FRIEND=true

# ---- LLM ----
LLM_API_KEY=sk-替换成你的DeepSeek密钥
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=60
MAX_HISTORY=40
SYSTEM_PROMPT=你是一个乐于助人的中文聊天伙伴，回答简洁自然。

# ---- 人设 ----
# 人设文件路径（相对项目根目录）；留空则只用上面的 SYSTEM_PROMPT
PERSONA_FILE=data/personas/default.yaml

# ---- 日志 ----
LOG_LEVEL=INFO

# ---- Stage 4：稳定性 & 长期记忆 ----
# 限流：同用户在 LLM 处理中又发新消息时，只保留最新一条待处理（中间丢弃）
# 设为 0 则关闭丢弃（所有消息排队等处理）
MAX_PENDING_PER_USER=1
# 自动摘要：messages 累计到此条数时触发 LLM 摘要压缩
SUMMARY_THRESHOLD=15
# 自动摘要：压缩后滑窗口保留多少条近期对话
SUMMARY_KEEP=10
# 自动摘要：生成时的 temperature（越低越稳定）
LLM_SUMMARY_TEMP=0.3

# ---- Stage 5：参考语料轻量检索 ----
# 参考语料目录（放 reference.txt，纯文本角色台词/语录）；留空或目录不存在则跳过
STYLE_DIR=data/style

# ---- Stage 6：角色状态系统 ----
# 角色状态目录（存每用户的 affection/trust/valence/arousal 等）；留空或目录不存在则跳过
STATE_DIR=data/state

# ---- Stage 7：长期记忆库 + 主动发消息 ----
# 长期记忆目录（存每用户的分类记忆）；留空或目录不存在则跳过
MEMORY_DIR=data/memories
# 主动发消息开关（需同时启用 STATE_DIR 才会生效）
ENABLE_PROACTIVE=true
# 主动发消息：距上次聊天最少隔多少小时才发
PROACTIVE_MIN_HOURS=12
# 主动发消息：最低好感度（Level 2 亲近以上才会主动）
PROACTIVE_MIN_AFFECTION=30
# 主动发消息：允许时间窗口（凌晨不打扰）
PROACTIVE_WINDOW_START=08:00
PROACTIVE_WINDOW_END=23:00

# ---- Stage 8：识图 ----
# 发图片给机器人时是否启用视觉理解
VISION_ENABLED=true
# 单条消息最多处理几张图
VISION_MAX_IMAGES=3
# 单张图片大小上限（MB），超过跳过
VISION_MAX_MB=16
# 画质档位：low（省 token，512px 内）/ high（高清，token 消耗大）
VISION_DETAIL=low

# ---- Stage 8.2：记忆检索强化 ----
# 回忆意图触发时的记忆检索条数（用户消息含「记得/上次/之前」等关键词时启用）
RECALL_TOP_K=15
